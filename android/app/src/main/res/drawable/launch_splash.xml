<?xml version="1.0" encoding="utf-8"?>
<!-- RapidReach splash: navy gradient + centered vector emblem (API 23+ item sizing). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#070D18"
                android:centerColor="#152238"
                android:endColor="#0B1628" />
        </shape>
    </item>
    <item
        android:width="128dp"
        android:height="128dp"
        android:gravity="center"
        android:drawable="@drawable/ic_splash_emblem" />
</layer-list>
